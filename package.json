{
  "name": "playwright-ai-framework",
  "version": "1.0.0",
  "description": "AI-assisted UI automation framework using Playwright and Claude",
  "main": "server/workflow-api.js",
  "scripts": {
    "start": "cd server && node workflow-api.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "jira:fetch": "node src/shared/integrations/fetch-jira-story.js",
    "test:windows": "wdio run wdio.windows.config.js",
    "test:windows:notepad": "cross-env WINDOWS_APP=\"C:\\Windows\\System32\\notepad.exe\" wdio run wdio.windows.config.js",
    "test:windows:hp": "cross-env WINDOWS_APP=\"AD2F1837.myHP_v10z8vjag6ke6!App\" wdio run wdio.windows.config.js --spec src/windows/tests/hp-app-smoke.spec.js",
    "windows:show-report": "start \"\" test-results\\windows\\html\\report.html",
    "appium:install:windows": "npx appium driver install windows",
    "appium:start": "npx appium --address 127.0.0.1 --port 4723 --log logs/appium-windows.log",
    "test:mac": "wdio run wdio.mac.config.js",
    "test:mac:hp": "cross-env MAC_BUNDLE_ID=\"com.hp.SmartForDesktop\" wdio run wdio.mac.config.js --spec src/mac/tests/hp-smart-smoke.spec.js",
    "test:mac:calculator": "cross-env MAC_BUNDLE_ID=\"com.apple.calculator\" wdio run wdio.mac.config.js",
    "mac:show-report": "open test-results/mac/html/report.html",
    "appium:install:mac": "npx appium driver install mac2",
    "appium:mac:start": "npx appium --address 127.0.0.1 --port 4724 --log logs/appium-mac.log"
  },
  "keywords": [
    "playwright",
    "automation",
    "ai",
    "testing",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@playwright/mcp": "^0.0.70",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "mobilewright": "^0.0.29",
    "openai": "^6.22.0",
    "sharp": "^0.33.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@mobilewright/test": "^0.0.29",
    "@playwright/experimental-ct-react": "^1.58.2",
    "@playwright/test": "^1.58.2",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/json-reporter": "^9.20.0",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "appium": "^3.4.2",
    "appium-mac2-driver": "^1.10.0",
    "appium-windows-driver": "^5.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.1.0",
    "wdio-html-nice-reporter": "^8.1.7",
    "wdio-video-reporter": "^6.2.0",
    "webdriverio": "^9.27.1"
  }
}
